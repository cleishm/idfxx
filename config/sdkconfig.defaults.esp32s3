# Target-specific overrides for esp32s3.
# Enable PSRAM so that PSRAM-only components (idfxx_epaper_el133uf1) build and
# run their tests. Modules without PSRAM still boot (IGNORE_NOTFOUND). PSRAM is
# available only through capability-based allocation, so malloc still returns
# internal RAM for every other test.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
