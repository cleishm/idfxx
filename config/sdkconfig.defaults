CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_COMPILER_CXX_RTTI=y
CONFIG_COMPILER_CXX_STD_23=y
CONFIG_ESP_TIMER_SUPPORTS_ISR_DISPATCH_METHOD=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="config/partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="config/partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESP_SYSTEM_PANIC_PRINT_HALT=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# WebSocket support for idfxx_http_server
CONFIG_HTTPD_WS_SUPPORT=y

# Response header lookup for idfxx_http_client
CONFIG_ESP_HTTP_CLIENT_SAVE_RESPONSE_HEADERS=y

# Static IPv6 neighbor API for idfxx_netif (ESP-IDF 6.1+)
CONFIG_LWIP_ND6_SUPPORT_STATIC_ENTRIES=y

# Long file names for idfxx_fatfs (the default changed from none to heap in ESP-IDF 6.0)
CONFIG_FATFS_LFN_HEAP=y

# SHA-3 for idfxx_crypto tests (off by default)
CONFIG_MBEDTLS_SHA3_C=y
