CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_COMPILER_CXX_RTTI=y
CONFIG_ESP_TIMER_SUPPORTS_ISR_DISPATCH_METHOD=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="config/partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="config/partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESP_SYSTEM_PANIC_PRINT_HALT=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# WebSocket support for idfxx_http_server
CONFIG_HTTPD_WS_SUPPORT=y

# Response header lookup for idfxx_http_client
CONFIG_ESP_HTTP_CLIENT_SAVE_RESPONSE_HEADERS=y

# Static IPv6 neighbor API for idfxx_netif (ESP-IDF 6.1+)
CONFIG_LWIP_ND6_SUPPORT_STATIC_ENTRIES=y

# Long file names for idfxx_fatfs (the default changed from none to heap in ESP-IDF 6.0)
CONFIG_FATFS_LFN_HEAP=y

# SHA-3 for idfxx_crypto tests (off by default)
CONFIG_MBEDTLS_SHA3_C=y

# AES-CMAC for idfxx_crypto tests (off by default on ESP-IDF 5.5)
CONFIG_MBEDTLS_CMAC_C=y

# Thread-safe keys for idfxx_crypto: the threading layer, with the pthread implementation. On
# ESP-IDF 5.5, the threading layer is off by default. Its default ALT implementation has no locks
# outside the ROM port.
CONFIG_MBEDTLS_THREADING_C=y
CONFIG_MBEDTLS_THREADING_PTHREAD=y
# CONFIG_MBEDTLS_THREADING_ALT is not set

# With this option enabled, idfxx_log's tests can add sinks that receive every log line. The option
# is off by default. config/sdkconfig.no-ipv6 builds without it.
CONFIG_IDFXX_LOG_ALL_LINES=y

# The mDNS console commands for idfxx_mdns need the console component, which the network test app
# doesn't include
# CONFIG_MDNS_ENABLE_CONSOLE_CLI is not set
