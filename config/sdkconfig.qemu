# QEMU-specific configuration for ESP32-S3
# This file is copied to the build directory's sdkconfig before building for QEMU

# Inherit base C++ settings from sdkconfig.defaults
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_COMPILER_CXX_RTTI=y

# Custom partition table for QEMU
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="config/partitions_qemu.csv"
CONFIG_PARTITION_TABLE_FILENAME="config/partitions_qemu.csv"

# Flash size for QEMU (4MB to fit the partition table)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# UART console for QEMU serial output
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# No USB Serial/JTAG secondary console. From ESP-IDF 6.1.1, its startup waits for BBPLL
# calibration. QEMU before esp-develop-9.2.2-20261109 never reports the calibration, so boot hangs.
# The fix is in espressif/qemu 98feb8b8. Remove this setting when ESP-IDF's tools.json pins a QEMU
# that has the fix. The CI qemu-test job fails when that happens.
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Larger main task stack for TLS tests
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# Unity test framework
CONFIG_UNITY_ENABLE_FLOAT=y
CONFIG_UNITY_ENABLE_DOUBLE=y
CONFIG_UNITY_ENABLE_FIXTURE=y

# Reduce logs for cleaner test output
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Define QEMU build flag for conditional compilation
CONFIG_IDF_TARGET_QEMU=y

# WebSocket support for idfxx_http_server tests
CONFIG_HTTPD_WS_SUPPORT=y

# Response header lookup for idfxx_http_client tests
CONFIG_ESP_HTTP_CLIENT_SAVE_RESPONSE_HEADERS=y

# Static IPv6 neighbor API for idfxx_netif (ESP-IDF 6.1+)
CONFIG_LWIP_ND6_SUPPORT_STATIC_ENTRIES=y

# Long file names for idfxx_fatfs tests (the default changed from none to heap in ESP-IDF 6.0)
CONFIG_FATFS_LFN_HEAP=y

# SHA-3 for idfxx_crypto tests (off by default)
CONFIG_MBEDTLS_SHA3_C=y

# AES-CMAC for idfxx_crypto tests (off by default on ESP-IDF 5.5)
CONFIG_MBEDTLS_CMAC_C=y

# Thread-safe keys for idfxx_crypto (on by default from ESP-IDF 6.0; see config/sdkconfig.defaults)
CONFIG_MBEDTLS_THREADING_C=y
CONFIG_MBEDTLS_THREADING_PTHREAD=y
# CONFIG_MBEDTLS_THREADING_ALT is not set

# With this option enabled, idfxx_log's tests can add sinks that receive every log line. The option
# is off by default.
CONFIG_IDFXX_LOG_ALL_LINES=y
