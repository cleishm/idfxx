INCLUDE_FILE_PATTERNS  =
# Macros normally supplied by ESP-IDF headers (not on the include path) are
# predefined here so every API available on some supported target or
# configuration is documented. Values are listed one per line so each group can
# carry its own comment.
#
# Deliberately left undefined: SOC_GPIO_SUPPORT_HOLD_SINGLE_IO_IN_DSLP (tested as
# negated; defining it hides gpio::deep_sleep_hold_*), CONFIG_IDF_TARGET_ESP32
# (selects between alternative enumerators) and CONFIG_IDFXX_STD_FORMAT (only
# gates internal formatter specializations).

# Language and Doxygen
PREDEFINED             = __cplusplus=202302L
PREDEFINED             += __cpp_lib_format=202106L
PREDEFINED             += __DOXYGEN__

# ESP-IDF version: document the newest API surface (99.0.0 exceeds any real release)
PREDEFINED             += "ESP_IDF_VERSION_VAL(major,minor,patch)=(((major)<<16)|((minor)<<8)|(patch))"
PREDEFINED             += "ESP_IDF_VERSION=ESP_IDF_VERSION_VAL(99,0,0)"

# SOC capabilities, numeric: maximum across supported targets
PREDEFINED             += SOC_CPU_CORES_NUM=2
PREDEFINED             += SOC_HP_I2C_NUM=2
PREDEFINED             += SOC_LP_I2C_NUM=1
PREDEFINED             += SOC_UART_HP_NUM=5
PREDEFINED             += SOC_UART_LP_NUM=1
PREDEFINED             += SOC_LEDC_CHANNEL_NUM=8
PREDEFINED             += SOC_SPI_PERIPH_NUM=3
PREDEFINED             += SOC_WIFI_MAC_VERSION_NUM=3
PREDEFINED             += SOC_GPIO_VALID_GPIO_MASK=0xFFFFFFFFFFFFFFFF

# SOC capabilities, boolean: enabled so capability-gated API is documented
PREDEFINED             += SOC_GPIO_SUPPORT_PIN_HYS_FILTER
PREDEFINED             += SOC_GPIO_SUPPORT_PIN_HYS_CTRL_BY_EFUSE
PREDEFINED             += SOC_GPIO_SUPPORT_FORCE_HOLD
PREDEFINED             += SOC_GPIO_SUPPORT_DEEPSLEEP_WAKEUP
PREDEFINED             += SOC_I2C_SUPPORT_10BIT_ADDR
PREDEFINED             += SOC_I2C_SUPPORT_APB
PREDEFINED             += SOC_I2C_SUPPORT_REF_TICK
PREDEFINED             += SOC_I2C_SUPPORT_RTC
PREDEFINED             += SOC_I2C_SUPPORT_XTAL
PREDEFINED             += SOC_IEEE802154_SUPPORTED
PREDEFINED             += SOC_LEDC_GAMMA_CURVE_FADE_SUPPORTED
PREDEFINED             += SOC_LEDC_SUPPORT_APB_CLOCK
PREDEFINED             += SOC_LEDC_SUPPORT_FADE_STOP
PREDEFINED             += SOC_LEDC_SUPPORT_HS_MODE
PREDEFINED             += SOC_LEDC_SUPPORT_PLL_DIV_CLOCK
PREDEFINED             += SOC_LEDC_SUPPORT_REF_TICK
PREDEFINED             += SOC_LEDC_SUPPORT_XTAL_CLOCK
PREDEFINED             += SOC_LP_I2C_SUPPORTED
PREDEFINED             += SOC_PM_SUPPORT_EXT0_WAKEUP
PREDEFINED             += SOC_PM_SUPPORT_EXT1_WAKEUP
PREDEFINED             += SOC_RTC_GPIO_EDGE_WAKEUP_SUPPORTED
PREDEFINED             += SOC_USB_OTG_SUPPORTED
PREDEFINED             += SOC_USB_SERIAL_JTAG_SUPPORTED
PREDEFINED             += SOC_WIFI_HE_SUPPORT
PREDEFINED             += SOC_WIFI_SUPPORT_5G

# Kconfig feature switches
PREDEFINED             += CONFIG_COMPILER_CXX_EXCEPTIONS
PREDEFINED             += CONFIG_ESP_TIMER_SUPPORTS_ISR_DISPATCH_METHOD
PREDEFINED             += CONFIG_HEAP_HAS_EXEC_HEAP
PREDEFINED             += CONFIG_HTTPD_WS_SUPPORT
PREDEFINED             += CONFIG_LWIP_IPV6
PREDEFINED             += CONFIG_NVS_ENCRYPTION

