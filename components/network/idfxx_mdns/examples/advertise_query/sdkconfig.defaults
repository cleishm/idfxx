CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_COMPILER_CXX_RTTI=y
CONFIG_COMPILER_CXX_STD_23=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# The mDNS console commands need the console component, which this example
# does not use.
CONFIG_MDNS_ENABLE_CONSOLE_CLI=n

# The browser callback formats log messages on the mDNS task.
CONFIG_MDNS_TASK_STACK_SIZE=6144

# The hostname_changed listener logs on the system event task.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
